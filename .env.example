# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Database (direct connection, used by Prisma) ─────────
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── n8n (self-hosted orchestration substrate, SAD §3.2) ───
N8N_WEBHOOK_SECRET=change-me-in-production
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me


# ── Email OAuth (Phase 3 — Email Intelligence) ────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Encryption (OAuth tokens at rest) ─────────────────────
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Claude API (Phase 3 — Classifier Agent) ───────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ── Cron (Phase 5 — scheduled risk detection) ─────────────
# Vercel Cron sends this as: Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# ── Embeddings (Phase 7 — Memory Module, SAD §2.6) ────────
# Voyage AI (Anthropic's recommended embedding partner) — required for the
# embedding pipeline (embedding-pipeline.ts) and semantic retrieval
# (memory-retrieval-service.ts) to run. Without it, memory consolidation
# still writes rows (embeddingStatus=pending) but nothing gets embedded or
# becomes retrievable until this is set.
VOYAGE_API_KEY=
# Defaults to voyage-3-large (1536 dimensions, matching memory_entries.embedding
# vector(1536)) if unset. Only override with another 1536-dimension model.
EMBEDDING_MODEL=voyage-3-large
